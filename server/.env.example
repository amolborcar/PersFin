PORT=3001
# Plaid — the only bank/brokerage provider. OAuth institutions require Production.
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=production

# The AI assistant runs on your local Claude Code login (no API key needed).
# Only set this if the binary isn't auto-detected — point it at the executable:
# CLAUDE_BIN=/usr/local/bin/claude

# SEC EDGAR (fund-holdings look-through) requires automated clients to declare
# a contact in the User-Agent ("Name you@example.com" — fair-access policy).
# Optional: defaults to the project's contact; set your own if EDGAR 403s you.
# SEC_EDGAR_UA="PersFin you@example.com"

# The API only answers requests addressed to a local-looking hostname (localhost,
# IP addresses, single-label names like "nas", *.local, *.lan, *.home.arpa,
# *.ts.net) — this blocks DNS-rebinding attacks from websites you visit. If you
# reach PersFin through another name (custom domain, reverse proxy), list it here
# (comma-separated) and restart.
# PERSFIN_ALLOWED_HOSTS=persfin.example.com

# Weekly report delivery — set these in Setup → Report delivery (they are saved
# here). Links in the report open PERSFIN_PUBLIC_URL (your Tailscale address).
# PERSFIN_PUBLIC_URL=http://mac-mini.tail1234.ts.net:3001
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# REPORT_EMAIL_TO=you@gmail.com
# SMTP_FROM=
# NTFY_URL=http://mac-mini.tail1234.ts.net:2586/persfin
# NTFY_TOKEN=tk_...
